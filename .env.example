# Environment variables template for feature-store-mvp.
# Copy to `.env` and adjust values for your local setup. NEVER commit `.env`.

# --- PostgreSQL (Offline Store) ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=feature_store
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feature_store

# --- Redis (Online Store) -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Logging --------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Feature pipeline -----------------------------------------------------
# How often (in hours) batch features are recomputed.
FEATURE_REFRESH_CADENCE_HOURS=24
