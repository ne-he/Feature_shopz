# --- Environment & secrets ----------------------------------------------
.env
.env.*
!.env.example

# --- Data files -----------------------------------------------------------
# Datasets are never committed; keep folder placeholders only.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
ecommerce_synthetic_dataset.csv

# --- Python bytecode & caches --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Build & packaging ----------------------------------------------------
build/
dist/
*.egg-info/
.eggs/

# --- Testing & coverage ---------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Type checking & linting ----------------------------------------------
.mypy_cache/
.ruff_cache/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/

# --- Orchestration & databases -------------------------------------------
.prefect/
*.db
*.sqlite3

# --- IDE & OS -------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Logs -----------------------------------------------------------------
logs/
*.log

# --- Local instructions & assets ----------------------------------------------
CLAUDE.md
PRD.md
*.mp4
*.mov
*.avi

# The frontend showcase IS tracked (index.html + poster + screenshots), but
# heavy video and scratch/dev artifacts under it are not.
frontend/mlev1/uploads/
frontend/mlev1/.thumbnail
frontend/mlev1/archive/
frontend/MLv2/.thumbnail

# MLv2 background video IS served as a static asset (Option A: ships with the app),
# so it must be tracked despite the global *.mp4 ignore above. Compress it first.
!frontend/MLv2/uploads/hero-stream.mp4
